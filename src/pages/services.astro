---
import PageLayout from '../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const pageContent = await getEntry('pages', 'services');
const description = pageContent?.data.description ?? 'Layanan penyusunan dokumen CSMS, gap analysis, pendampingan audit, dan digitalisasi K3LL.';
const title = `Layanan Konsultasi CSMS & Perizinan — ${siteConfig.siteName}`;
const seoImage = siteUrl(pageContent?.data.image || '/images/services/services-csms.svg', true);
const serviceDirectoryBlock = pageContent?.data.contentBlocks?.find((block) => block.type === 'service-directory');
---
<PageLayout
  title={title}
  description={description}
  image={seoImage}
  breadcrumbs={[{ label: 'Layanan', href: '/services' }]}
>
  {serviceDirectoryBlock ? <BlockRenderer blocks={[serviceDirectoryBlock]} /> : null}
</PageLayout>
