---
import PageLayout from '../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const pageContent = await getEntry('pages', 'contact');
const title = `Kontak & Konsultasi — ${siteConfig.siteName}`;
const description = pageContent?.data.description ?? 'Hubungi tim kami untuk konsultasi CSMS dan K3LL.';
const seoImage = siteUrl(pageContent?.data.image || '/images/contact/contact.svg', true);
---
<PageLayout
  title={title}
  description={description}
  image={seoImage}
  breadcrumbs={[{ label: 'Kontak', href: '/contact' }]}
>
  <BlockRenderer blocks={pageContent?.data.contentBlocks ?? []} />
</PageLayout>
