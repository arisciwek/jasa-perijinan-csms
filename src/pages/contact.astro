---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const title = `Kontak & Konsultasi — ${siteConfig.siteName}`;
const description = 'Hubungi tim ahli kami untuk konsultasi gratis pembuatan dokumen CSMS dan perizinan bisnis. Respon cepat via WhatsApp atau formulir.';
const image = siteUrl('/images/contact/contact.svg');
---
<PageLayout
  title={title}
  description={description}
  image={image}
  breadcrumbs={[{ label: 'Kontak', href: '/contact' }]}
>
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-center text-gray-900 sm:text-4xl mb-4">
        Hubungi Kami
      </h1>
      <p class="text-center text-lg text-gray-600 max-w-2xl mx-auto mb-12">
        Konsultasikan kebutuhan CSMS dan perizinan perusahaan Anda secara gratis dengan tim ahli kami.
      </p>

      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Info & WhatsApp -->
        <div class="space-y-8">
          <div class="bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Layanan Cepat via WhatsApp</h2>
            <p class="text-gray-600 mb-6 text-sm">
              Untuk respon paling cepat, silakan hubungi nomor WhatsApp konsultasi kami berikut:
            </p>
            <div class="space-y-4">
              <a
                href="https://wa.me/628112676071"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center p-4 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors shadow-sm"
              >
                <span class="font-bold text-lg">WhatsApp 1: +62 811 2676071</span>
              </a>
              <a
                href="https://wa.me/6281929012587"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center p-4 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors shadow-sm"
              >
                <span class="font-bold text-lg">WhatsApp 2: +62 81929012587</span>
              </a>
            </div>
          </div>

          <div class="bg-gray-50 p-8 rounded-xl border border-gray-200 space-y-4">
            <h2 class="text-xl font-bold text-gray-900">Jam Operasional</h2>
            <p class="text-gray-600 text-sm">
              <strong>Senin - Jumat:</strong> 08:00 - 17:00 WIB<br/>
              <strong>Sabtu - Minggu:</strong> Tutup (Layanan darurat konsultasi 24/7 via WhatsApp)
            </p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-gray-50 p-8 rounded-xl border border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 mb-6">Formulir Permintaan Konsultasi</h2>
          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Terima kasih! Pesan Anda telah dikirim. Tim kami akan segera menghubungi Anda.');">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
              <input type="text" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Nama Anda" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nama Perusahaan</label>
              <input type="text" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="PT Contoh Mandiri" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nomor WhatsApp / Telepon</label>
              <input type="tel" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="08123456789" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Pilih Layanan</label>
              <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500">
                <option>Penyusunan Dokumen CSMS dari Nol</option>
                <option>Review & Gap Analysis CSMS</option>
                <option>Pendampingan Verifikasi & Audit HSE</option>
                <option>Digitalisasi & Standardisasi K3LL</option>
                <option>Perizinan Usaha / OSS / HKI</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Pesan / Detail Kebutuhan</label>
              <textarea rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Jelaskan kebutuhan atau kendala CSMS Anda..."></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors shadow-sm">
              Kirim Permintaan Konsultasi
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</PageLayout>