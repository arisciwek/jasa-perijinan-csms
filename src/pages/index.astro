---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import LatestArticles from '../components/blocks/LatestArticles.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const title = siteConfig.defaultTitle;
const description = siteConfig.defaultDescription;
const image = siteUrl('/images/home/home-hero.svg');
const seoImage = siteUrl('/images/home/home-hero.svg', true);
const homeContent = await getEntry('pages', 'home');
const statsBlock = homeContent?.data.contentBlocks?.find((block) => block.type === 'stats-grid');
const servicesBlock = homeContent?.data.contentBlocks?.find((block) => block.type === 'service-card-grid');
const csmsElementsBlock = homeContent?.data.contentBlocks?.find((block) => block.type === 'csms-element-grid');
const latestArticles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---
<PageLayout
  title={title}
  description={description}
  image={seoImage}
  pageType="WebSite"
>
  <!-- Hero Section -->
  <section class="py-16 bg-white hero-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 hero-container">
      <header class="hero-header text-center mb-12">
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">
          Solusi Digital Pembuatan Dokumen Keselamatan Kontraktor
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Konsultan jasa pembuatan dokumen Sistem Manajemen Keselamatan Kontraktor (CSMS)
          secara digital untuk memastikan keberhasilan proses verifikasi skor CSMS tertinggi
          dari client di sektor hulu Migas, Tambang, Manufakturing, Konstruksi, Petrokimia
          dan sektor industri lain dalam satu platform terpercaya.
        </p>
      </header>
      <div class="hero-actions mt-10 flex justify-center space-x-6">
        <a
          href="#services"
          class="px-6 py-3 bg-primary-600 text-white font-medium rounded-lg shadow-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white focus:ring-primary-500"
        >
          Layanan Kami
        </a>
        <a
          href={`https://wa.me/${siteConfig.whatsapp}`}
          class="px-6 py-3 bg-green-600 text-white font-medium rounded-lg shadow-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white focus:ring-green-500"
        >
          Konsultasi Gratis via WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Section: content comes from src/content/pages/home.md -->
  {statsBlock ? <BlockRenderer blocks={[statsBlock]} /> : null}
  {servicesBlock ? <BlockRenderer blocks={[servicesBlock]} /> : null}

  <!-- Services Preview: content comes from src/content/pages/home.md -->

  <!-- Visual Section (SVG Illustration) -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative mx-auto max-w-4xl">
        <img 
          src={image} 
          alt="Ilustrasi solusi digital pembuatan dokumen CSMS dengan 9 elemen utama" 
          class="w-full h-auto rounded-xl shadow-lg"
        />
      </div>
    </div>
  </section>

  <!-- CSMS element preview is maintained in src/content/pages/home.md -->
  {csmsElementsBlock ? <BlockRenderer blocks={[csmsElementsBlock]} /> : null}

  <!-- Testimonials and consultation CTA are maintained in src/content/pages/home.md -->
  <BlockRenderer blocks={(homeContent?.data.contentBlocks ?? []).filter((block) => block.type === 'testimonial-grid' || block.type === 'call-to-action')} />

  <LatestArticles articles={latestArticles} />
</BaseLayout>