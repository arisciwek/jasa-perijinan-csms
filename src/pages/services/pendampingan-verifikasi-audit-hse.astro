---
import PageLayout from '../../layouts/PageLayout.astro';
import { siteConfig, siteUrl } from '../../config/site.ts';

const title = `Pendampingan Verifikasi & Audit HSE — ${siteConfig.siteName}`;
const description = 'Pendampingan intensif saat auditor principal/verifikator independen melakukan audit lapangan maupun verifikasi dokumen. Dari simulasi persiapan hingga penutupan audit & Corrective Action Plan.';
const image = siteUrl('/images/services/service-3-audit.svg');
const seoImage = siteUrl('/images/services/service-3-audit.svg', true);

const breadcrumbs = [
  { label: 'Layanan', href: '/services' },
  { label: 'Pendampingan Verifikasi & Audit HSE', href: '/services/pendampingan-verifikasi-audit-hse' }
];
---
<PageLayout title={title} description={description} image={seoImage} breadcrumbs={breadcrumbs} pageType="Service" relatedService="audit">
  <section class="py-16 bg-white service-detail-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 service-detail-container">
      <header class="service-detail-header text-center mb-16">
        <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">Layanan Utama #3</span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">Pendampingan Verifikasi & Audit HSE</h1>
        <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-8">Simulasi audit, pendampingan langsung saat audit principal, penanganan temuan (CAP), hingga lolos verifikasi.</p>
        <div class="service-detail-header-media flex justify-center">
          <img src={image} alt="Pendampingan Verifikasi & Audit HSE" class="w-full max-w-2xl h-auto rounded-xl shadow-md border border-gray-100" />
        </div>
      </header>

      <div class="service-detail-content grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 service-detail-main space-y-10">
          <article class="service-detail-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deskripsi Layanan</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Memiliki dokumen CSMS lengkap **bukan jaminan lolos verifikasi**. Auditor principal (Pertamina, Shell, BP, Medco, PGN, dll) atau verifikator independen akan mengevaluasi: kesesuaian dokumen dengan lapangan, kompetensi personel, bukti implementasi 12-24 bulan terakhir, dan kemampuan menjawab pertanyaan teknis di TKP. Layanan ini mendampingi Anda **sebelum, selama, dan sesudah** audit.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Kami jadi "bridge" antara tim klien dan auditor: memastikan dokumen siap, tim siap, lokasi siap, dan setiap temuan ditangani profesional agar tidak jadi NC Major yang gagalkan verifikasi.
            </p>
          </article>

          <article class="service-detail-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Cakupan Pendampingan</h2>
            <ul class="space-y-3 text-gray-700 list-disc list-inside">
              <li><strong>Pre-Audit (2-4 minggu sebelum):</strong> Simulasi audit lengkap (dokumen + lapangan + wawancara), gap closing, briefing tim</li>
              <li><strong>During Audit (Hari-H):</strong> Pendampingan di ruang meeting & TKP, clarifikasi pertanyaan auditor, manajemen evidence, real-time note taking</li>
              <li><strong>Post-Audit:</strong> Penyusunan Corrective Action Plan (CAP) per temuan, tracking hingga closed, verifikasi efektivitas koreksi</li>
              <li><strong>Surveillance Audit:</strong> Pendampingan audit berkala (6/12 bulanan) untuk maintain status verifikasi</li>
            </ul>
          </article>

          <article class="service-detail-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Jenis Audit yang Didukung</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead class="bg-primary-50 text-primary-900">
                  <tr>
                    <th class="p-3 font-semibold">Jenis Audit</th>
                    <th class="p-3 font-semibold">Principal/Standar</th>
                    <th class="p-3 font-semibold">Durasi Pendampingan</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">Verifikasi CSMS</td><td class="p-3">Pertamina, Shell, BP, Medco, PGN, dll</td><td class="p-3">3-5 hari (tergantung scope)</td></tr>
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">Audit SMK3 (PP 50/2012)</td><td class="p-3">Kementerian Ketenagakerjaan</td><td class="p-3">2-4 hari</td></tr>
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">Audit ISO 45001</td><td class="p-3">Sertifikasi Body (LRQA, BSI, TUV, dll)</td><td class="p-3">2-3 hari (Stage 1 & 2)</td></tr>
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">HSE Audit Kontraktor</td><td class="p-3">Principal Project Owner</td><td class="p-3">1-3 hari</td></tr>
                </tbody>
              </table>
            </div>
          </article>

          <article class="service-detail-article bg-primary-50 p-8 rounded-xl border border-primary-200">
            <h2 class="text-2xl font-bold text-primary-900 mb-4">Keunggulan Pendampingan Kami</h2>
            <ul class="space-y-2 text-primary-800 list-disc list-inside">
              <li><strong>Insider Perspective:</strong> Tim kami pernah jadi auditor/verifikator principal → tahu fokus & "pet peeve" auditor</li>
              <li><strong>Calm Under Pressure:</strong> Menangani pertanyaan teknis keras, menghindari jawaban yang memicu NC</li>
              <li><strong>Evidence Ready:</strong> Siapkan evidence fisik/digital sebelum auditor minta</li>
              <li><strong>CAP Success Rate:</strong> 95%+ temuan tertutup dalam 30 hari pasca-audit</li>
            </ul>
          </article>
        </div>

        <aside class="service-detail-sidebar space-y-6">
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="font-bold text-gray-900 mb-4">Navigasi Layanan</h3>
            <nav class="space-y-2">
              <a href="/services/penyusunan-dokumen-csms" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Penyusunan Dokumen CSMS dari Nol</a>
              <a href="/services/review-gap-analysis-csms" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Review & Gap Analysis CSMS</a>
              <a href="/services/pendampingan-verifikasi-audit-hse" class="block bg-primary-50 text-primary-800 p-3 rounded-lg font-medium border border-primary-200">→ Pendampingan Verifikasi & Audit HSE</a>
              <a href="/services/digitalisasi-standardisasi-k3ll" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Digitalisasi & Standardisasi K3LL</a>
            </nav>
          </div>

          <div class="bg-primary-600 text-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-3">Akan Hadapi Audit Verifikasi?</h3>
            <p class="text-primary-100 mb-4 text-sm">Jangan hadapi sendirian. Kami pendampingi dari simulasi hingga CAP closed. Track record 100% lolos.</p>
            <a href="/contact" class="inline-block bg-white text-primary-600 font-medium px-5 py-2 rounded-lg hover:bg-primary-50 transition-colors text-sm">Konsultasi Gratis</a>
          </div>

          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
            <h3 class="font-bold text-gray-900 mb-3">Checklist Siap Audit (Gratis)</h3>
            <p class="text-sm text-gray-600 mb-3">Download checklist 50 item persiapan audit verifikasi CSMS:</p>
            <a href="/contact" class="inline-block text-primary-600 font-medium text-sm hover:underline">Minta Checklist →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>