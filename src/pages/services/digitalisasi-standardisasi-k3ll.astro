---
import { getEntry } from 'astro:content';
import ServiceDetail from '../../components/blocks/ServiceDetail.astro';

const pageContent = await getEntry('pages', 'digitalisasi-standardisasi-k3ll');
const serviceBlock = pageContent?.data.contentBlocks?.find((block) => block.type === 'service-detail');
---
{serviceBlock && pageContent ? <ServiceDetail {...serviceBlock.data} pageTitle={pageContent.data.title} pageDescription={pageContent.data.description ?? ''} image={pageContent.data.image ?? '/images/services/service-4-digitalisasi.svg'} /> : null}
