---
import PageLayout from '../../layouts/PageLayout.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { getCollection } from 'astro:content';
import { siteConfig, siteUrl } from '../../config/site.ts';

const title = `Penyusunan Dokumen CSMS dari Nol — ${siteConfig.siteName}`;
const description = 'Layanan penyusunan lengkap 9 Elemen CSMS, Manual K3LL, POS, dan form pendukung untuk kontraktor baru yang ingin lolos prakualifikasi principal migas, tambang, konstruksi.';
const image = siteUrl('/images/services/service-1-penyusunan.svg');
const seoImage = siteUrl('/images/services/service-1-penyusunan.svg', true);

const breadcrumbs = [
  { label: 'Layanan', href: '/services' },
  { label: 'Penyusunan Dokumen CSMS', href: '/services/penyusunan-dokumen-csms' }
];

const articles = (await getCollection('articles'))
  .filter(a => !a.data.draft && a.data.relatedService === 'penyusunan')
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---
<PageLayout title={title} description={description} image={seoImage} breadcrumbs={breadcrumbs} pageType="Service">
  <section class="py-16 bg-white service-detail-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 service-detail-container">
      <header class="service-detail-header text-center mb-16">
        <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">Layanan Utama #1</span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">Penyusunan Dokumen CSMS dari Nol</h1>
        <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-8">Solusi end-to-end untuk perusahaan/kontraktor yang belum memiliki dokumentasi K3LL dan harus lolos verifikasi CSMS principal.</p>
        <div class="service-detail-header-media flex justify-center">
          <img src={image} alt="Penyusunan Dokumen CSMS dari Nol" class="w-full max-w-2xl h-auto rounded-xl shadow-md border border-gray-100" />
        </div>
      </header>

      <div class="service-detail-content grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 service-detail-main space-y-10">
          <article class="service-detail-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deskripsi Layanan</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Bagi kontraktor baru atau perusahaan yang baru masuk sektor migas, tambang, petrokimia, dan konstruksi besar, memiliki dokumen CSMS yang lengkap dan sesuai standar adalah <strong>syarat mutlak</strong> untuk lolos prakualifikasi dan tender. Kami menyusun seluruh dokumentasi Sistem Manajemen Keselamatan Kerja dan Lingkungan (K3LL) dari nol, custom sesuai karakteristik proyek dan syarat principal.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Layanan ini mencakup: analisis kebutuhan (gap analysis awal), penyusunan 9 Elemen CSMS lengkap, Manual K3LL, Prosedur Operasional Standar (POS/SWP), formulir pendukung, register risiko (HIRA/JSA), serta panduan implementasi agar dokumen tidak hanya "lulus verifikasi" tapi benar-benar可操作 di lapangan。
            </p>
          </article>

          <article class="service-detail-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Cakupan Pekerjaan (Scope)</h2>
            <ul class="space-y-3 text-gray-700 list-disc list-inside">
              <li><strong>Kick-off & Gap Analysis:</strong> Survey kondisi existing, identifikasi syarat principal, penetapan timeline</li>
              <li><strong>Elemen #1-9 CSMS:</strong> Penyusunan dokumen per elemen (kebijakan, organisasi, risiko, prosedur, implementasi, audit, kinerja, pencapaian)</li>
              <li><strong>Manual K3LL & POS/SWP:</strong> Dokumen induk + prosedur operasional per aktivitas risiko tinggi</li>
              <li><strong>Form & Register:</strong> HIRA, JSA, Inspection Checklist, Incident Report, Training Record, dll</li>
              <li><strong>Review & Finalisasi:</strong> Review internal, revisi per masukan klien, finalisasi dokumen siap verifikasi</li>
              <li><strong>Handover & Sosialisasi:</strong> Penyerahan dokumen (hardcopy + digital), briefing ke tim HSE klien</li>
            </ul>
          </article>

          <article class="service-detail-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Timeline & Deliverable</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead class="bg-primary-50 text-primary-900">
                  <tr>
                    <th class="p-3 font-semibold">Tahap</th>
                    <th class="p-3 font-semibold">Durasi</th>
                    <th class="p-3 font-semibold">Output</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">1. Kick-off & Survey</td><td class="p-3">1-2 minggu</td><td class="p-3">Laporan Gap Analysis & Rencana Kerja</td></tr>
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">2. Drafting Dokumen</td><td class="p-3">4-6 minggu</td><td class="p-3">Draft 9 Elemen + Manual + POS/SWP + Form</td></tr>
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">3. Review & Revisi</td><td class="p-3">2-3 minggu</td><td class="p-3">Dokumen Revisi (max 2x putaran)</td></tr>
                  <tr class="hover:bg-gray-50"><td class="p-3 font-medium">4. Finalisasi & Handover</td><td class="p-3">1 minggu</td><td class="p-3">Dokumen Final (PDF + Word editable) + Briefing</td></tr>
                </tbody>
              </table>
            </div>
            <p class="mt-4 text-sm text-gray-500">*Total estimasi: 8-12 minggu, tergantung kompleksitas & kesiapan data klien.</p>
          </article>

          <article class="service-detail-article bg-primary-50 p-8 rounded-xl border border-primary-200">
            <h2 class="text-2xl font-bold text-primary-900 mb-4">Mengapa Pilih Kami?</h2>
            <ul class="space-y-2 text-primary-800 list-disc list-inside">
              <li><strong>100% Passing Rate:</strong> Semua klien lolos verifikasi CSMS principal (Pertamina, Shell, BP, dll)</li>
              <li><strong>Pengalaman Sektor:</strong> Migas hulu/hilir, tambang, petrokimia, konstruksi berat, pembangkit listrik</li>
              <li><strong>Dokumen "Hidup":</strong> Bukan copy-paste template, tapi custom operasional klien</li>
              <li><strong>Support Pasca-Verifikasi:</strong> Bantuan update dokumen, audit internal, simulasi audit</li>
              <li><strong>Tim Ahli:</strong> Konsultan bersertifikat AK3 Umum, berpengalaman 15+ tahun</li>
            </ul>
          </article>

          <RelatedArticles articles={articles} title="Artikel Terkait Layanan Ini" />
        </div>

        <aside class="service-detail-sidebar space-y-6">
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="font-bold text-gray-900 mb-4">Navigasi Layanan</h3>
            <nav class="space-y-2">
              <a href="/services/penyusunan-dokumen-csms" class="block bg-primary-50 text-primary-800 p-3 rounded-lg font-medium border border-primary-200">→ Penyusunan Dokumen CSMS dari Nol</a>
              <a href="/services/review-gap-analysis-csms" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Review & Gap Analysis CSMS</a>
              <a href="/services/pendampingan-verifikasi-audit-hse" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Pendampingan Verifikasi & Audit HSE</a>
              <a href="/services/digitalisasi-standardisasi-k3ll" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Digitalisasi & Standardisasi K3LL</a>
            </nav>
          </div>

          <div class="bg-primary-600 text-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-3">Butuh Dokumen CSMS dari Nol?</h3>
            <p class="text-primary-100 mb-4 text-sm">Kami siap bantu susun 9 Elemen CSMS lengkap custom untuk proyek Anda. Timeline 8-12 minggu.</p>
            <a href="/contact" class="inline-block bg-white text-primary-600 font-medium px-5 py-2 rounded-lg hover:bg-primary-50 transition-colors text-sm">Konsultasi Gratis</a>
          </div>

          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
            <h3 class="font-bold text-gray-900 mb-3">Klien Typikal</h3>
            <ul class="space-y-2 text-sm text-gray-700 list-disc list-inside">
              <li>Kontraktor baru ingin tender migas/tambang</li>
              <li>Perusahaan ekspansi ke sektor baru</li>
              <li>Kontraktor sub-kontrak butuh dokumen sendiri</li>
              <li>Perusahaan tanpa tim HSE internal</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>