---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';

const pageContent = await getEntry('pages', 'audit-tinjauan');
---
<BlockRenderer
  blocks={pageContent?.data.contentBlocks ?? []}
  pageMetadata={{
    title: pageContent?.data.title ?? "Elemen #7: Audit & Tinjauan Pelaksanaan K3LL",
    description: pageContent?.data.description ?? '',
    image: pageContent?.data.image ?? "/images/csms-elements/elemen-7-audit.svg",
  }}
/>
