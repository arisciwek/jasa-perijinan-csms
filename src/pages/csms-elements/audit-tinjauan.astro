---
import ElementLayout from '../../layouts/ElementLayout.astro';
import { siteConfig, siteUrl } from '../../config/site.ts';

const title = `Elemen #7: Audit & Tinjauan Pelaksanaan K3LL — ${siteConfig.siteName}`;
const description = 'Evaluasi efektivitas sistem: audit internal berkala, audit pihak ketiga/independen, Management Review Meeting, dan follow-up temuan audit hingga tertutup.';
const image = siteUrl('/images/csms-elements/elemen-7-audit.svg');
const seoImage = siteUrl('/images/csms-elements/elemen-7-audit.svg', true);

const breadcrumbs = [
  { label: 'Elemen CSMS', href: '/csms-elements' },
  { label: 'Audit & Tinjauan Pelaksanaan', href: '/csms-elements/audit-tinjauan' }
];
---
<ElementLayout title={title} description={description} image={seoImage} breadcrumbs={breadcrumbs} elementId={7}>
  <header slot="header" class="elemen-header text-center mb-16">
        <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">Elemen #7</span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">Audit & Tinjauan Pelaksanaan K3LL</h1>
        <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-8">Audit internal, audit independen, Management Review Meeting, follow-up temuan hingga tertutup.</p>
        <div class="elemen-header-media flex justify-center">
          <img src={image} alt="Ilustrasi Audit & Tinjauan Pelaksanaan CSMS" class="w-full max-w-2xl h-auto rounded-xl shadow-md border border-gray-100" />
        </div>
      </header>
          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deskripsi Elemen</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Elemen ini adalah mekanisme "check" dalam siklus PDCA (Plan-Do-Check-Act). Termasuk: audit internal berkala (minimal 1x setahun) oleh auditor internal yang kompeten & independen, audit oleh pihak ketiga/verifikator independen sesuai jadwal principal, Management Review Meeting (MRM) oleh top management untuk meninjau performa sistem, dan follow-up temuan audit (corrective & preventive action) hingga status closed dengan verifikasi efektivitas.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Auditor verifikasi CSMS sangat memperhatikan: independensi auditor internal, cakupan audit (semua elemen & area), kualitas laporan audit, bukti MRM (agenda, kehadiran, keputusan, action items), dan efektivitas penutupan temuan (bukti koreksi, verifikasi, tidak rekurennya temuan).
            </p>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Mengapa Elemen Ini Penting?</h2>
            <ul class="space-y-3 text-gray-700 list-disc list-inside">
              <li><strong>Validasi sistem:</strong> Audit membuktikan sistem berjalan sesuai rencana (conformance).</li>
              <li><strong>Kemampuan mandiri:</strong> Audit internal menunjukkan kemampuan self-assessment perusahaan.</li>
              <li><strong>Accountability top management:</strong> MRM memaksa pimpinan review performa K3LL.</li>
              <li><strong>Perbaikan berkelanjutan:</strong> Follow-up temuan = continuous improvement nyata.</li>
            </ul>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deliverable Umum (Bukti Verifikasi)</h2>
            <ul class="space-y-2 text-gray-700 list-disc list-inside">
              <li>Jadwal & rencana audit internal tahunan (terbit sebelum tahun berjalan)</li>
              <li>Kualifikasi & independensi auditor internal (sertifikat, tidak audit area sendiri)</li>
              <li>Laporan audit internal per area/elemen (temuan: conformance, OFI, NC minor/major)</li>
              <li>Laporan audit pihak ketiga / verifikator independen</li>
              <li>MoM Management Review Meeting (agenda, data review, keputusan, action items)</li>
              <li>Register temuan audit + corrective action plan (PIC, target, bukti closed)</li>
              <li>Verifikasi efektivitas koreksi (audit follow-up / re-check)</li>
            </ul>
          </article>

          <article class="elemen-article bg-primary-50 p-8 rounded-xl border border-primary-200">
            <h2 class="text-2xl font-bold text-primary-900 mb-4">Bagaimana Kami Membantu</h2>
            <ul class="space-y-2 text-primary-800 list-disc list-inside">
              <li>Menyusun <strong>Program Audit Internal</strong> tahunan (jadwal, cakupan, auditor)</li>
              <li>Melatih <strong>Auditor Internal</strong> metodologi audit CSMS/SMK3/ISO 45001</li>
              <li>Melakukan <strong>Audit Internal / Pre-audit</strong> independen sebelum verifikasi principal</li>
              <li>Mempersiapkan <strong>Materi & Data Management Review Meeting</strong></li>
              <li>Pendampingan <strong>penyusunan & tracking CAP</strong> temuan audit hingga closed</li>
            </ul>
          </article>


  <div slot="aside" class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="font-bold text-gray-900 mb-4">Navigasi 9 Elemen</h3>
            <nav class="space-y-2">
              <a href="/csms-elements/kepemimpinan-komitmen" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #1: Kepemimpinan & Komitmen</a>
              <a href="/csms-elements/kebijaksanaan-sasaran" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #2: Kebijaksanaan & Sasaran</a>
              <a href="/csms-elements/organisasi-tanggungjawab" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #3: Organisasi & Tanggung Jawab</a>
              <a href="/csms-elements/manajemen-risiko" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #4: Manajemen Risiko</a>
              <a href="/csms-elements/perencanaan-prosedur" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #5: Perencanaan & Prosedur</a>
              <a href="/csms-elements/implementasi-pemantauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #6: Implementasi & Pemantauan</a>
              <a href="/csms-elements/audit-tinjauan" class="block bg-primary-50 text-primary-800 p-3 rounded-lg font-medium border border-primary-200">→ Elemen #7: Audit & Tinjauan</a>
              <a href="/csms-elements/pencapaian-kinerja" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #8: Pencapaian Kinerja</a>
              <a href="/csms-elements/pencapaian-lainnya" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #9: Pencapaian Lainnya</a>
            </nav>
          </div>

          <div class="bg-primary-600 text-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-3">Butuh Bantuan Elemen #7?</h3>
            <p class="text-primary-100 mb-4 text-sm">Kami bantu program audit internal, pelatihan auditor, pre-audit verifikasi, MRM, & CAP tracking.</p>
            <a href="/contact" class="inline-block bg-white text-primary-600 font-medium px-5 py-2 rounded-lg hover:bg-primary-50 transition-colors text-sm">Konsultasi Gratis</a>
          </div>
        </div>
</ElementLayout>