---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
const pageContent = await getEntry('pages', 'perencanaan-prosedur');
---
<BlockRenderer blocks={pageContent?.data.contentBlocks ?? []} pageMetadata={{
  title: pageContent?.data.title ?? "Elemen #5: Perencanaan & Prosedur",
  description: pageContent?.data.description ?? '',
  image: pageContent?.data.image ?? "/images/csms-elements/elemen-5-perencanaan.svg",
}} />
