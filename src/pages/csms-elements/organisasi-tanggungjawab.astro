---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
const pageContent = await getEntry('pages', 'organisasi-tanggungjawab');
---
<BlockRenderer blocks={pageContent?.data.contentBlocks ?? []} pageMetadata={{
  title: pageContent?.data.title ?? "Elemen #3: Organisasi & Tanggung Jawab",
  description: pageContent?.data.description ?? '',
  image: pageContent?.data.image ?? "/images/csms-elements/elemen-3-organisasi.svg",
}} />
