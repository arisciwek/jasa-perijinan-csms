---
import ElementLayout from '../../layouts/ElementLayout.astro';
import { siteConfig, siteUrl } from '../../config/site.ts';

const title = `Elemen #3: Organisasi & Tanggung Jawab — ${siteConfig.siteName}`;
const description = 'Struktur organisasi K3LL yang jelas dengan job description per jabatan, penunjukan HSE Officer kompeten, dan rantai perintah yang terdefinisi dengan baik.';
const image = siteUrl('/images/csms-elements/elemen-3-organisasi.svg');
const seoImage = siteUrl('/images/csms-elements/elemen-3-organisasi.svg', true);

const breadcrumbs = [
  { label: 'Elemen CSMS', href: '/csms-elements' },
  { label: 'Organisasi & Tanggung Jawab', href: '/csms-elements/organisasi-tanggungjawab' }
];
---
<ElementLayout title={title} description={description} image={seoImage} breadcrumbs={breadcrumbs} elementId={3}>
  <header slot="header" class="elemen-header text-center mb-16">
        <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">Elemen #3</span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">Organisasi & Tanggung Jawab</h1>
        <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-8">Struktur organisasi K3LL yang jelas: organogram, job description, HSE Officer kompeten, dan rantai perintah terdefinisi.</p>
        <div class="elemen-header-media flex justify-center">
          <img src={image} alt="Ilustrasi Organisasi & Tanggung Jawab CSMS" class="w-full max-w-2xl h-auto rounded-xl shadow-md border border-gray-100" />
        </div>
      </header>
          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deskripsi Elemen</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Elemen ini memastikan struktur organisasi untuk mengelola K3LL sudah ada, jelas, dan berfungsi. Termasuk: organogram K3LL, penunjukan HSE Officer / K3LL Coordinator yang memenuhi kriteria kompetensi, job description K3LL untuk semua level (dari Direktur ke Supervisor), serta rantai perintah dan komunikasi K3LL yang terdefinisi.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Auditor akan memeriksa: apakah HSE Officer benar-benar kompeten (sertifikasi AK3 Umum/Pelaksana), apakah job description mencakup tanggung jawab K3LL, apakah ada delegasi wewenang yang jelas, dan apakah struktur mendukung komunikasi 2 arah (top-down & bottom-up).
            </p>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Mengapa Elemen Ini Penting?</h2>
            <ul class="space-y-3 text-gray-700 list-disc list-inside">
              <li><strong>Siapa bertanggung jawab?</strong> Tanpa struktur jelas, K3LL jadi "urusan semua orang" = "urusan tidak ada orang".</li>
              <li><strong>Kompetensi HSE:</strong> Principal mensyaratkan HSE Officer bersertifikat & berpengalaman sektor terkait.</li>
              <li><strong>Delegasi wewenang:</strong> Supervisor harus punya wewenang menghentikan pekerjaan tidak aman (Stop Work Authority).</li>
              <li><strong>Komunikasi:</strong> Saluran pelaporan insiden, near miss, dan saran perbaikan harus terbuka.</li>
            </ul>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deliverable Umum (Bukti Verifikasi)</h2>
            <ul class="space-y-2 text-gray-700 list-disc list-inside">
              <li>Organogram K3LL perusahaan (terupdate, divalidasi HR)</li>
              <li>Job Description K3LL per jabatan (Direktur → Supervisor → Operator)</li>
              <li>SK Penunjukan HSE Officer / K3LL Coordinator + sertifikat kompetensi</li>
              <li>Matrix tanggung jawab K3LL (RACI chart)</li>
              <li>Prosedur delegasi wewenang (Stop Work Authority)</li>
              <li>Struktur komite K3LL / Safety Committee (jika wajib)</li>
              <li>Bukti pelatihan orientasi K3LL untuk karyawan baru</li>
            </ul>
          </article>

          <article class="elemen-article bg-primary-50 p-8 rounded-xl border border-primary-200">
            <h2 class="text-2xl font-bold text-primary-900 mb-4">Bagaimana Kami Membantu</h2>
            <ul class="space-y-2 text-primary-800 list-disc list-inside">
              <li>Membuat <strong>Organogram & JD K3LL</strong> custom per struktur perusahaan</li>
              <li>Memvalidasi <strong>kompetensi HSE Officer</strong> vs syarat principal</li>
              <li>Menyusun <strong>RACI Matrix</strong> K3LL proyek/operasional</li>
              <li>Membuat <strong>Prosedur Stop Work Authority</strong> & sosialisasinya</li>
              <li>Pendampingan pembentukan <strong>Safety Committee</strong> efektif</li>
            </ul>
          </article>


  <div slot="aside" class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="font-bold text-gray-900 mb-4">Navigasi 9 Elemen</h3>
            <nav class="space-y-2">
              <a href="/csms-elements/kepemimpinan-komitmen" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #1: Kepemimpinan & Komitmen</a>
              <a href="/csms-elements/kebijaksanaan-sasaran" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #2: Kebijaksanaan & Sasaran</a>
              <a href="/csms-elements/organisasi-tanggungjawab" class="block bg-primary-50 text-primary-800 p-3 rounded-lg font-medium border border-primary-200">→ Elemen #3: Organisasi & Tanggung Jawab</a>
              <a href="/csms-elements/manajemen-risiko" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #4: Manajemen Risiko</a>
              <a href="/csms-elements/perencanaan-prosedur" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #5: Perencanaan & Prosedur</a>
              <a href="/csms-elements/implementasi-pemantauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #6: Implementasi & Pemantauan</a>
              <a href="/csms-elements/audit-tinjauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #7: Audit & Tinjauan</a>
              <a href="/csms-elements/pencapaian-kinerja" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #8: Pencapaian Kinerja</a>
              <a href="/csms-elements/pencapaian-lainnya" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #9: Pencapaian Lainnya</a>
            </nav>
          </div>

          <div class="bg-primary-600 text-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-3">Butuh Bantuan Elemen #3?</h3>
            <p class="text-primary-100 mb-4 text-sm">Kami bantu susun organogram, JD K3LL, validasi HSE Officer, RACI matrix, dan Safety Committee.</p>
            <a href="/contact" class="inline-block bg-white text-primary-600 font-medium px-5 py-2 rounded-lg hover:bg-primary-50 transition-colors text-sm">Konsultasi Gratis</a>
          </div>
        </div>
</ElementLayout>