---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
const pageContent = await getEntry('pages', 'kepemimpinan-komitmen');
---
<BlockRenderer
  blocks={pageContent?.data.contentBlocks ?? []}
  pageMetadata={{
    title: pageContent?.data.title ?? "Elemen #1: Kepemimpinan & Komitmen",
    description: pageContent?.data.description ?? '',
    image: pageContent?.data.image ?? "/images/csms-elements/elemen-1-kepemimpinan.svg",
  }}
/>
