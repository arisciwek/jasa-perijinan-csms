---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
const pageContent = await getEntry('pages', 'kebijaksanaan-sasaran');
---
<BlockRenderer
  blocks={pageContent?.data.contentBlocks ?? []}
  pageMetadata={{
    title: pageContent?.data.title ?? "Elemen #2: Kebijaksanaan & Sasaran Strategis",
    description: pageContent?.data.description ?? '',
    image: pageContent?.data.image ?? "/images/csms-elements/elemen-2-kebijaksanaan.svg",
  }}
/>
