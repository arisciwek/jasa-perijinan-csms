---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
const pageContent = await getEntry('pages', 'manajemen-risiko');
---
<BlockRenderer blocks={pageContent?.data.contentBlocks ?? []} pageMetadata={{
  title: pageContent?.data.title ?? "Elemen #4: Manajemen Risiko",
  description: pageContent?.data.description ?? '',
  image: pageContent?.data.image ?? "/images/csms-elements/elemen-4-manajemen-risiko.svg",
}} />
