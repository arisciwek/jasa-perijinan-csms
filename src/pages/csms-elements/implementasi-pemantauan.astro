---
import PageLayout from '../../layouts/PageLayout.astro';
import { siteConfig, siteUrl } from '../../config/site.ts';

const title = `Elemen #6: Implementasi & Pemantauan — ${siteConfig.siteName}`;
const description = 'Pelaksanaan dan pengawasan di lapangan: inspeksi rutin (harian/mingguan/bulanan), K3 Patrol & Observation, pengukuran lingkungan (noise, dust, gas), pelaporan & investigasi insiden.';
const image = siteUrl('/images/csms-elements/elemen-6-implementasi.svg');
const seoImage = siteUrl('/images/csms-elements/elemen-6-implementasi.svg', true);

const breadcrumbs = [
  { label: 'Elemen CSMS', href: '/csms-elements' },
  { label: 'Implementasi & Pemantauan', href: '/csms-elements/implementasi-pemantauan' }
];
---
<PageLayout title={title} description={description} image={seoImage} breadcrumbs={breadcrumbs} pageType="Article">
  <section class="py-16 bg-white elemen-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 elemen-container">
      <header class="elemen-header text-center mb-16">
        <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">Elemen #6</span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">Implementasi & Pemantauan</h1>
        <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-8">Inspeksi rutin, K3 Patrol & Observation, pengukuran lingkungan, pelaporan & investigasi insiden.</p>
        <div class="elemen-header-media flex justify-center">
          <img src={image} alt="Ilustrasi Implementasi & Pemantauan CSMS" class="w-full max-w-2xl h-auto rounded-xl shadow-md border border-gray-100" />
        </div>
      </header>

      <div class="elemen-content grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 elemen-main space-y-10">
          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deskripsi Elemen</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Elemen ini memastikan bahwa yang tertulis di prosedur (Elemen #5) benar-benar dilaksanakan dan dipantau di lapangan. Termasuk: program inspeksi rutin (harian oleh supervisor, mingguan oleh HSE, bulanan oleh manajemen), K3 Patrol & Behavior-Based Safety Observation, pengukuran lingkungan kerja (noise, dust, gas, heat, lighting), serta sistem pelaporan & investigasi insiden (termasuk near miss) dengan root cause analysis (5 Why, Fishbone).
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Kunci: bukti fisik (checklist tanda tangan, foto, data pengukuran), follow-up temuan inspeksi tertutup (closed loop), dan investigasi insiden yang mencari root cause bukan mencari kambing hitam.
            </p>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Mengapa Elemen Ini Penting?</h2>
            <ul class="space-y-3 text-gray-700 list-disc list-inside">
              <li><strong>Execution gap:</strong> Banyak perusahaan punya prosedur bagus tapi tidak dieksekusi di lapangan.</li>
              <li><strong>Early warning:</strong> Inspeksi & observation menangkap kondisi tidak aman sebelum jadi insiden.</li>
              <li><strong>Data-driven:</strong> Pengukuran lingkungan & statistik insiden jadi basis perbaikan.</li>
              <li><strong>Learning organization:</strong> Investigasi near miss mencegah insiden fatal di masa depan.</li>
            </ul>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deliverable Umum (Bukti Verifikasi)</h2>
            <ul class="space-y-2 text-gray-700 list-disc list-inside">
              <li>Jadwal & checklist inspeksi rutin (harian/mingguan/bulanan) + bukti pelaksanaan</li>
              <li>Form & data K3 Patrol / BBS Observation (min. target per bulan)</li>
              <li>Hasil pengukuran lingkungan (noise, dust, gas, heat, lighting) lab terakreditasi</li>
              <li>Register insiden & near miss (tercatat, ditelusuri, follow-up)</li>
              <li>Laporan investigasi insiden dengan RCA (5 Why / Fishbone) & corrective action</li>
              <li>Tracking corrective action hingga closed (verifikasi efektivitas)</li>
              <li>Laporan bulanan K3LL ke manajemen & principal</li>
            </ul>
          </article>

          <article class="elemen-article bg-primary-50 p-8 rounded-xl border border-primary-200">
            <h2 class="text-2xl font-bold text-primary-900 mb-4">Bagaimana Kami Membantu</h2>
            <ul class="space-y-2 text-primary-800 list-disc list-inside">
              <li>Menyusun <strong>Program Inspeksi</strong> terstruktur (jadwal, checklist, PIC, frekuensi)</li>
              <li>Melatih tim <strong>K3 Patrol & BBS Observation</strong> metodologi yang efektif</li>
              <li>Koordinasi <strong>pengukuran lingkungan</strong> dengan lab terakreditasi</li>
              <li>Membangun sistem <strong>pelaporan & investigasi insiden</strong> (form, alur, RCA)</li>
              <li>Pendampingan <strong>investigasi insiden kritis</strong> & penyusunan CAP</li>
            </ul>
          </article>
        </div>

        <aside class="elemen-sidebar space-y-6">
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="font-bold text-gray-900 mb-4">Navigasi 9 Elemen</h3>
            <nav class="space-y-2">
              <a href="/csms-elements/kepemimpinan-komitmen" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #1: Kepemimpinan & Komitmen</a>
              <a href="/csms-elements/kebijaksanaan-sasaran" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #2: Kebijaksanaan & Sasaran</a>
              <a href="/csms-elements/organisasi-tanggungjawab" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #3: Organisasi & Tanggung Jawab</a>
              <a href="/csms-elements/manajemen-risiko" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #4: Manajemen Risiko</a>
              <a href="/csms-elements/perencanaan-prosedur" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #5: Perencanaan & Prosedur</a>
              <a href="/csms-elements/implementasi-pemantauan" class="block bg-primary-50 text-primary-800 p-3 rounded-lg font-medium border border-primary-200">→ Elemen #6: Implementasi & Pemantauan</a>
              <a href="/csms-elements/audit-tinjauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #7: Audit & Tinjauan</a>
              <a href="/csms-elements/pencapaian-kinerja" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #8: Pencapaian Kinerja</a>
              <a href="/csms-elements/pencapaian-lainnya" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #9: Pencapaian Lainnya</a>
            </nav>
          </div>

          <div class="bg-primary-600 text-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-3">Butuh Bantuan Elemen #6?</h3>
            <p class="text-primary-100 mb-4 text-sm">Kami bantu program inspeksi, K3 Patrol, pengukuran lingkungan, sistem insiden & RCA.</p>
            <a href="/contact" class="inline-block bg-white text-primary-600 font-medium px-5 py-2 rounded-lg hover:bg-primary-50 transition-colors text-sm">Konsultasi Gratis</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>