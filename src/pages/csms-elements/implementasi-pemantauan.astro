---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
const pageContent = await getEntry('pages', 'implementasi-pemantauan');
---
<BlockRenderer blocks={pageContent?.data.contentBlocks ?? []} pageMetadata={{
  title: pageContent?.data.title ?? "Elemen #6: Implementasi & Pemantauan",
  description: pageContent?.data.description ?? '',
  image: pageContent?.data.image ?? "/images/csms-elements/elemen-6-implementasi.svg",
}} />
