---
import ElementLayout from '../../layouts/ElementLayout.astro';
import { siteConfig, siteUrl } from '../../config/site.ts';

const title = `Elemen #8: Pencapaian Kinerja K3LL — ${siteConfig.siteName}`;
const description = 'Data statistik & tren keselamatan: laporan bulanan/tahunan K3LL, analisis tren kecelakaan & near miss, benchmarking standar industri, program perbaikan berkelanjutan.';
const image = siteUrl('/images/csms-elements/elemen-8-pencapaian-kinerja.svg');
const seoImage = siteUrl('/images/csms-elements/elemen-8-pencapaian-kinerja.svg', true);

const breadcrumbs = [
  { label: 'Elemen CSMS', href: '/csms-elements' },
  { label: 'Pencapaian Kinerja K3LL', href: '/csms-elements/pencapaian-kinerja' }
];
---
<ElementLayout title={title} description={description} image={seoImage} breadcrumbs={breadcrumbs} elementId={8}>
  <header slot="header" class="elemen-header text-center mb-16">
        <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">Elemen #8</span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">Pencapaian Kinerja K3LL</h1>
        <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-8">Laporan statistik K3LL, analisis tren insiden & near miss, benchmarking industri, perbaikan berkelanjutan.</p>
        <div class="elemen-header-media flex justify-center">
          <img src={image} alt="Ilustrasi Pencapaian Kinerja K3LL CSMS" class="w-full max-w-2xl h-auto rounded-xl shadow-md border border-gray-100" />
        </div>
      </header>
          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deskripsi Elemen</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Elemen ini mengukur "output" dari seluruh sistem CSMS. Termasuk: laporan K3LL bulanan & tahunan (statistik insiden, LTIFR, TRIR, near miss, man-hours, training hours), analisis tren (bulanan, kuartalan, tahunan) untuk mengidentifikasi pola & area prioritas, benchmarking dengan standar industri (IOGP, OGP, principal requirements) & best practice, serta program perbaikan berkelanjutan berbasis data.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Data harus: akurat, lengkap, tertib, dan dianalisis — bukan hanya dikumpulkan. Auditor mencari: konsistensi data antar laporan, analisis root cause dari tren, target perbaikan yang realistis, dan bukti implementasi program perbaikan.
            </p>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Mengapa Elemen Ini Penting?</h2>
            <ul class="space-y-3 text-gray-700 list-disc list-inside">
              <li><strong>Evidence-based:</strong> Kinerja K3LL dibuktikan data, bukan claim.</li>
              <li><strong>Trend analysis:</strong> Mengungkap pola tersembunyi (shift tertentu, area tertentu, tipe pekerjaan).</li>
              <li><strong>Benchmarking:</strong> Posisi relatif vs industri & principal → target perbaikan.</li>
              <li><strong>Continuous improvement:</strong> Data → insight → action → measure → repeat (PDCA).</li>
            </ul>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deliverable Umum (Bukti Verifikasi)</h2>
            <ul class="space-y-2 text-gray-700 list-disc list-inside">
              <li>Laporan K3LL bulanan (statistik lengkap: LTIFR, TRIR, Near Miss, Man-hours, Training)</li>
              <li>Laporan K3LL tahunan dengan analisis tren komprehensif</li>
              <li>Grafik/tren: LTIFR, TRIR, Near Miss Rate, Training Hours per bulan</li>
              <li>Analisis pola insiden: tipe, lokasi, shift, sebab, umur kerja, dll</li>
              <li>Benchmarking: posisi perusahaan vs standar industri & target principal</li>
              <li>Program perbaikan berkelanjutan (Continuous Improvement Program) berbasis data</li>
              <li>Bukti implementasi & efektivitas program perbaikan</li>
            </ul>
          </article>

          <article class="elemen-article bg-primary-50 p-8 rounded-xl border border-primary-200">
            <h2 class="text-2xl font-bold text-primary-900 mb-4">Bagaimana Kami Membantu</h2>
            <ul class="space-y-2 text-primary-800 list-disc list-inside">
              <li>Membangun <strong>Sistem Pelaporan K3LL</strong> terstandarisasi (template, alur, deadline)</li>
              <li>Menganalisis <strong>Data Historis</strong> untuk tren, pola, & root cause</li>
              <li>Membuat <strong>Dashboard K3LL</strong> real-time (LTIFR, TRIR, Near Miss, dll)</li>
              <li>Menyiapkan <strong>Benchmarking Report</strong> vs standar industri & principal</li>
              <li>Menyusun <strong>Continuous Improvement Program</strong> berbasis data & prioritas</li>
            </ul>
          </article>


  <div slot="aside" class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="font-bold text-gray-900 mb-4">Navigasi 9 Elemen</h3>
            <nav class="space-y-2">
              <a href="/csms-elements/kepemimpinan-komitmen" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #1: Kepemimpinan & Komitmen</a>
              <a href="/csms-elements/kebijaksanaan-sasaran" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #2: Kebijaksanaan & Sasaran</a>
              <a href="/csms-elements/organisasi-tanggungjawab" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #3: Organisasi & Tanggung Jawab</a>
              <a href="/csms-elements/manajemen-risiko" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #4: Manajemen Risiko</a>
              <a href="/csms-elements/perencanaan-prosedur" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #5: Perencanaan & Prosedur</a>
              <a href="/csms-elements/implementasi-pemantauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #6: Implementasi & Pemantauan</a>
              <a href="/csms-elements/audit-tinjauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #7: Audit & Tinjauan</a>
              <a href="/csms-elements/pencapaian-kinerja" class="block bg-primary-50 text-primary-800 p-3 rounded-lg font-medium border border-primary-200">→ Elemen #8: Pencapaian Kinerja</a>
              <a href="/csms-elements/pencapaian-lainnya" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #9: Pencapaian Lainnya</a>
            </nav>
          </div>

          <div class="bg-primary-600 text-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-3">Butuh Bantuan Elemen #8?</h3>
            <p class="text-primary-100 mb-4 text-sm">Kami bantu sistem pelaporan, analisis tren, dashboard K3LL, benchmarking, & program perbaikan.</p>
            <a href="/contact" class="inline-block bg-white text-primary-600 font-medium px-5 py-2 rounded-lg hover:bg-primary-50 transition-colors text-sm">Konsultasi Gratis</a>
          </div>
        </div>
</ElementLayout>