---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';

const pageContent = await getEntry('pages', 'pencapaian-kinerja');
---
<BlockRenderer
  blocks={pageContent?.data.contentBlocks ?? []}
  pageMetadata={{
    title: pageContent?.data.title ?? "Elemen #8: Pencapaian Kinerja K3LL",
    description: pageContent?.data.description ?? '',
    image: pageContent?.data.image ?? "/images/csms-elements/elemen-8-pencapaian-kinerja.svg",
  }}
/>
