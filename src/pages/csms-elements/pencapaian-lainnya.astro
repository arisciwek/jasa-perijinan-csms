---
import ElementLayout from '../../layouts/ElementLayout.astro';
import { siteConfig, siteUrl } from '../../config/site.ts';

const title = `Elemen #9: Pencapaian Lainnya — ${siteConfig.siteName}`;
const description = 'Penghargaan, sertifikasi pendukung, inovasi K3LL, dan partisipasi forum industri. Elemen penunjang yang memperkuat posisi perusahaan dalam verifikasi CSMS dan tender.';
const image = siteUrl('/images/csms-elements/elemen-9-pencapaian-lainnya.svg');
const seoImage = siteUrl('/images/csms-elements/elemen-9-pencapaian-lainnya.svg', true);

const breadcrumbs = [
  { label: 'Elemen CSMS', href: '/csms-elements' },
  { label: 'Pencapaian Lainnya', href: '/csms-elements/pencapaian-lainnya' }
];
---
<ElementLayout title={title} description={description} image={seoImage} breadcrumbs={breadcrumbs} elementId={9}>
  <header slot="header" class="elemen-header text-center mb-16">
        <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">Elemen #9</span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">Pencapaian Lainnya</h1>
        <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-8">Sertifikasi pendukung, penghargaan K3LL, inovasi, partisipasi forum industri — value-added untuk verifikasi & tender.</p>
        <div class="elemen-header-media flex justify-center">
          <img src={image} alt="Ilustrasi Pencapaian Lainnya CSMS" class="w-full max-w-2xl h-auto rounded-xl shadow-md border border-gray-100" />
        </div>
      </header>
          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deskripsi Elemen</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Elemen ini mencakup pencapaian di luar 8 elemen inti yang memperkuat profil K3LL perusahaan: sertifikasi sistem manajemen (ISO 45001, SMK3 PP 50/2012), penghargaan K3LL dari principal/pemerintah (Zero Accident Award, Best HSE Performance, dll), inovasi K3LL (digitalisasi, alat bantu keselamatan, metodologi baru), serta partisipasi aktif di forum K3LL industri (IKK, HSE Forum, komite normalisasi).
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Meskipun "penunjang", elemen ini sering jadi pembeda di tender ketat. Principal memandang: apakah perusahaan proaktif naik level (sertifikasi), diakui eksternal (penghargaan), berinovasi (efisiensi & efektivitas), dan berkontribusi ke industri (forum).
            </p>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Mengapa Elemen Ini Penting?</h2>
            <ul class="space-y-3 text-gray-700 list-disc list-inside">
              <li><strong>Differentiator tender:</strong> Diantara peserta yang sama-sama lolos 8 elemen, ini jadi tie-breaker.</li>
              <li><strong>Credibility:</strong> Sertifikasi & penghargaan = validasi pihak ketiga.</li>
              <li><strong>Inovasi = efisiensi:</strong> Digitalisasi & alat bantu menurunkan biaya & risiko jangka panjang.</li>
              <li><strong>Networking & update:</strong> Forum industri = akses regulasi terbaru & best practice.</li>
            </ul>
          </article>

          <article class="elemen-article bg-gray-50 p-8 rounded-xl border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Deliverable Umum (Bukti Verifikasi)</h2>
            <ul class="space-y-2 text-gray-700 list-disc list-inside">
              <li>Sertifikat ISO 45001 / SMK3 (jika sudah tersertifikasi)</li>
              <li>Surat penetapan/penghargaan K3LL dari principal/pemerintah (3-5 thn terakhir)</li>
              <li>Dokumentasi inovasi K3LL: deskripsi, manfaat, bukti implementasi, hasil evaluasi</li>
              <li>Bukti partisipasi forum: undangan, kehadiran, peran (pembicara, panitia, anggota)</li>
              <li>Publikasi/presentasi K3LL di seminar/konferensi industri</li>
              <li>Program CSR K3LL (sosialisasi K3 ke sekolah, masyarakat sekitar, dll)</li>
              <li>Testimoni/rekomendasi dari principal/klien sebelumnya</li>
            </ul>
          </article>

          <article class="elemen-article bg-primary-50 p-8 rounded-xl border border-primary-200">
            <h2 class="text-2xl font-bold text-primary-900 mb-4">Bagaimana Kami Membantu</h2>
            <ul class="space-y-2 text-primary-800 list-disc list-inside">
              <li>Pendampingan <strong>persiapan sertifikasi ISO 45001 / SMK3</strong> (gap analysis, dokumen, audit internal)</li>
              <li>Menyusun <strong>nominasi penghargaan K3LL</strong> (dokumentasi pencapaian, evidence, presentasi)</li>
              <li>Mengidentifikasi & mendokumentasikan <strong>inovasi K3LL</strong> yang sudah ada di perusahaan</li>
              <li>Fasilitasi <strong>partisipasi forum industri</strong> & speaking opportunity</li>
              <li>Membangun <strong>Portofolio Pencapaian K3LL</strong> untuk kebutuhan tender & verifikasi</li>
            </ul>
          </article>


  <div slot="aside" class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="font-bold text-gray-900 mb-4">Navigasi 9 Elemen</h3>
            <nav class="space-y-2">
              <a href="/csms-elements/kepemimpinan-komitmen" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #1: Kepemimpinan & Komitmen</a>
              <a href="/csms-elements/kebijaksanaan-sasaran" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #2: Kebijaksanaan & Sasaran</a>
              <a href="/csms-elements/organisasi-tanggungjawab" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #3: Organisasi & Tanggung Jawab</a>
              <a href="/csms-elements/manajemen-risiko" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #4: Manajemen Risiko</a>
              <a href="/csms-elements/perencanaan-prosedur" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #5: Perencanaan & Prosedur</a>
              <a href="/csms-elements/implementasi-pemantauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #6: Implementasi & Pemantauan</a>
              <a href="/csms-elements/audit-tinjauan" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #7: Audit & Tinjauan</a>
              <a href="/csms-elements/pencapaian-kinerja" class="block text-gray-700 hover:bg-gray-50 p-3 rounded-lg transition-colors">Elemen #8: Pencapaian Kinerja</a>
              <a href="/csms-elements/pencapaian-lainnya" class="block bg-primary-50 text-primary-800 p-3 rounded-lg font-medium border border-primary-200">→ Elemen #9: Pencapaian Lainnya</a>
            </nav>
          </div>

          <div class="bg-primary-600 text-white p-6 rounded-xl">
            <h3 class="font-bold text-lg mb-3">Butuh Bantuan Elemen #9?</h3>
            <p class="text-primary-100 mb-4 text-sm">Kami bantu sertifikasi ISO 45001/SMK3, nominasi award, dokumentasi inovasi, & portofolio pencapaian.</p>
            <a href="/contact" class="inline-block bg-white text-primary-600 font-medium px-5 py-2 rounded-lg hover:bg-primary-50 transition-colors text-sm">Konsultasi Gratis</a>
          </div>
        </div>
</ElementLayout>