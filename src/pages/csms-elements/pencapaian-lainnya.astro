---
import { getEntry } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';

const pageContent = await getEntry('pages', 'pencapaian-lainnya');
---
<BlockRenderer
  blocks={pageContent?.data.contentBlocks ?? []}
  pageMetadata={{
    title: pageContent?.data.title ?? "Elemen #9: Pencapaian Lainnya",
    description: pageContent?.data.description ?? '',
    image: pageContent?.data.image ?? "/images/csms-elements/elemen-9-pencapaian-lainnya.svg",
  }}
/>
