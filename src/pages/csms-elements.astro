---
import PageLayout from '../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const pageContent = await getEntry('pages', 'csms-elements');
const pageTitle = pageContent?.data.title ?? '9 Elemen Utama Contractor Safety Management System (CSMS)';
const title = `${pageTitle} — ${siteConfig.siteName}`;
const description = pageContent?.data.description ?? 'Penjelasan 9 elemen Contractor Safety Management System (CSMS).';
const elementsBlock = pageContent?.data.contentBlocks?.find((block) => block.type === 'csms-element-grid');
const image = siteUrl('/images/csms-elements/csms-elements.svg');
const seoImage = siteUrl('/images/csms-elements/csms-elements.svg', true);


---
<PageLayout
  title={title}
  description={description}
  image={seoImage}
  breadcrumbs={[{ label: 'Elemen CSMS', href: '/csms-elements' }]}
>
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-12">
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">{pageTitle}</h1>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">{description}</p>
      </header>
      {elementsBlock ? <BlockRenderer blocks={[elementsBlock]} /> : null}
    </div>
  </section>

</PageLayout>