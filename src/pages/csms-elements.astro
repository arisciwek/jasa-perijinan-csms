---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const title = `9 Elemen Utama CSMS — ${siteConfig.siteName}`;
const description = 'Penjelasan mendalam 9 elemen Contractor Safety Management System (CSMS): Kepemimpinan, Kebijakan, Organisasi, Manajemen Risiko, Prosedur, dan lainnya.';
const image = siteUrl('/images/csms-elements/csms-elements.svg');

const elements = [
  { id: 1, title: 'Kepemimpinan & Komitmen', desc: 'Bagaimana manajer senior terlibat langsung dalam manajemen K3LL dan menetapkan teladan keselamatan.' },
  { id: 2, title: 'Kebijaksanaan & Sasaran Strategis', desc: 'Dokumen kebijakan K3LL yang terintegrasi dengan tujuan strategis operasional perusahaan.' },
  { id: 3, title: 'Organisasi & Tanggung Jawab', desc: 'Struktur organisasi yang jelas untuk mengelola dan mengomunikasikan aspek K3LL.' },
  { id: 4, title: 'Manajemen Risiko', desc: 'Identifikasi bahaya, penilaian risiko, dan pengendalian hingga tingkat ALARP (As Low As Reasonably Practicable).' },
  { id: 5, title: 'Perencanaan & Prosedur', desc: 'Dokumen panduan operasi dan safe work practices yang disahkan perusahaan.' },
  { id: 6, title: 'Implementasi & Pemantauan', desc: 'Sistem pengawasan dan pemantauan kinerja K3LL secara berkala di lapangan.' },
  { id: 7, title: 'Audit & Tinjauan Pelaksanaan K3LL', desc: 'Evaluasi berkala dan audit independen untuk memastikan efektivitas sistem.' },
  { id: 8, title: 'Pencapaian Kinerja K3LL', desc: 'Pencatatan statistik keselamatan, insiden, dan perbaikan berkelanjutan.' },
  { id: 9, title: 'Pencapaian Lainnya', desc: 'Penghargaan, sertifikasi pendukung, dan inovasi khusus dalam program K3LL.' },
];
---
<PageLayout
  title={title}
  description={description}
  image={image}
  breadcrumbs={[{ label: 'Elemen CSMS', href: '/csms-elements' }]}
>
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-center text-gray-900 sm:text-4xl mb-4">
        9 Elemen Utama Contractor Safety Management System (CSMS)
      </h1>
      <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto mb-16">
        Standar penilaian verifikasi CSMS yang wajib dikuasai oleh setiap kontraktor di sektor hulu Migas, Tambang, Konstruksi, dan Energi.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {elements.map(el => (
          <div class="bg-gray-50 p-8 rounded-xl border border-gray-200 hover:shadow-md transition-shadow">
            <span class="inline-block bg-primary-100 text-primary-800 font-bold text-xs px-3 py-1 rounded-full mb-4">
              Elemen #{el.id}
            </span>
            <h2 class="text-xl font-bold text-gray-900 mb-3">{el.title}</h2>
            <p class="text-gray-600 text-sm leading-relaxed">{el.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>