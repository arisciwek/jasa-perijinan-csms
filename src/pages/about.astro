---
import PageLayout from '../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const pageContent = await getEntry('pages', 'about');
const pageTitle = pageContent?.data.title ?? 'Tentang Kami';
const title = `${pageTitle} — ${siteConfig.siteName}`;
const description = pageContent?.data.description ?? 'Informasi tentang layanan konsultan CSMS dan K3LL.';
const seoImage = siteUrl(pageContent?.data.image || '/images/about/about.svg', true);
---
<PageLayout
  title={title}
  description={description}
  image={seoImage}
  breadcrumbs={[{ label: 'Tentang Kami', href: '/about' }]}
>
  <BlockRenderer blocks={pageContent?.data.contentBlocks ?? []} />
</PageLayout>
