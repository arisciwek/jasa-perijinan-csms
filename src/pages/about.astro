---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const title = `Tentang Kami — ${siteConfig.siteName}`;
const description = 'Kenali tim ahli K3LL dan konsultan berpengalaman di balik Jasa Perijinan CSMS, siap mendampingi kontraktor mencapai skor verifikasi tertinggi.';
const image = siteUrl('/images/about/about.svg');
---
<PageLayout
  title={title}
  description={description}
  image={image}
  breadcrumbs={[{ label: 'Tentang Kami', href: '/about' }]}
>
  <!-- Hero Section -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-center text-gray-900 sm:text-4xl mb-6">
        Tentang Konsultan CSMS & Perizinan
      </h1>
      <p class="text-center text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Kami adalah mitra strategis terpercaya bagi kontraktor dan perusahaan di sektor hulu Migas, Tambang, Manufakturing, Konstruksi, dan Petrokimia. Dengan pengalaman bertahun-tahun dalam Sistem Manajemen Keselamatan Kontraktor (CSMS) dan perizinan legalitas korporasi, kami memastikan perusahaan Anda selalu siap menghadapi audit dan verifikasi principal.
      </p>
    </div>
  </section>

  <!-- Misi & Visi -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
          <h2 class="text-2xl font-bold text-gray-900 mb-4 text-primary-600">Visi Kami</h2>
          <p class="text-gray-600 leading-relaxed">
            Menjadi lembaga konsultan K3LL dan perizinan nomor satu di Indonesia yang diandalkan oleh kontraktor nasional maupun multinasional dalam mewujudkan zero accident dan operasional yang patuh hukum.
          </p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
          <h2 class="text-2xl font-bold text-gray-900 mb-4 text-primary-600">Misi Kami</h2>
          <ul class="space-y-3 text-gray-600">
            <li class="flex items-start">
              <span class="text-primary-600 font-bold mr-2">✓</span>
              Menyediakan pendampingan penyusunan dokumen CSMS yang akurat, cepat, dan sesuai standar internasional.
            </li>
            <li class="flex items-start">
              <span class="text-primary-600 font-bold mr-2">✓</span>
              Memastikan kelulusan 100% pada proses audit verifikasi principal.
            </li>
            <li class="flex items-start">
              <span class="text-primary-600 font-bold mr-2">✓</span>
              Memberikan edukasi dan transformasi digital pengelolaan K3LL bagi kontraktor modern.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Tim Ahli & Keunggulan -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-center text-gray-900 mb-12">Mengapa Memilih Kami?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <h3 class="font-bold text-lg text-gray-900 mb-2">100% Kelulusan</h3>
          <p class="text-gray-600 text-sm">Rekam jejak terbukti meloloskan ratusan kontraktor dalam verifikasi skor CSMS tingkat tinggi.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <h3 class="font-bold text-lg text-gray-900 mb-2">Praktisi Bersertifikat</h3>
          <p class="text-gray-600 text-sm">Didukung oleh tenaga ahli K3LL berpengalaman luas di sektor Migas, Tambang, dan Konstruksi.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <h3 class="font-bold text-lg text-gray-900 mb-2">Layanan Komprehensif</h3>
          <p class="text-gray-600 text-sm">Dari dokumen CSMS dari nol, gap analysis, pendampingan audit, hingga perizinan OSS & HKI.</p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>