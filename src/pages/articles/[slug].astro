---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig, siteUrl } from '../../config/site.ts';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(a => !a.data.draft)
    .map(article => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, tags, image, relatedService } = article.data;
const seoImage = image ? siteUrl(image, true) : siteUrl('/images/articles/articles.svg', true);
const formattedPubDate = new Date(pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdatedDate = updatedDate ? new Date(updatedDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) : null;
const tagsList = tags || [];
const categoryLabel = category || 'Artikel';
const authorName = author || 'Tim Konsultan CSMS';

const { Content } = await article.render();
---
<ArticleLayout
  title={title}
  description={description}
  image={seoImage}
  pubDate={pubDate}
  category={categoryLabel}
  author={authorName}
  tags={tagsList}
  breadcrumbs={[{ label: 'Artikel', href: '/articles' }, { label: title, href: `/articles/${article.slug}` }]}
  relatedService={relatedService}>
  <Content />
</ArticleLayout>