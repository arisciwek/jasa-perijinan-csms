---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import { getCollection } from 'astro:content';
import { siteConfig, siteUrl, getService } from '../../config/site.ts';
import { pickRelatedArticles } from '../../utils/related.ts';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(a => !a.data.draft)
    .map(article => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, tags, image, relatedService } = article.data;
const seoImage = image ? siteUrl(image, true) : siteUrl('/images/articles/articles.svg', true);
const categoryLabel = category || 'Artikel';
const authorName = author || 'Tim Konsultan CSMS';

const { Content, headings } = await article.render();
const allArticles = await getCollection('articles');
const service = getService(relatedService);
const relatedArticles = pickRelatedArticles(allArticles, {
  currentSlug: article.slug,
  serviceId: relatedService,
  category,
  limit: 3,
});
---
<ArticleLayout
  title={title}
  description={description}
  image={seoImage}
  pubDate={pubDate}
  category={categoryLabel}
  author={authorName}
  tags={tags || []}
  breadcrumbs={[{ label: 'Artikel', href: '/articles' }, { label: title, href: `/articles/${article.slug}` }]}
  service={service}
  relatedArticles={relatedArticles}
  headings={headings}>
  <Content />
  {article.data.contentBlocks?.length ? <BlockRenderer blocks={article.data.contentBlocks} /> : null}
</ArticleLayout>