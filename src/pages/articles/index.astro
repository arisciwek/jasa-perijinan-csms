---
import PageLayout from '../../layouts/PageLayout.astro';
import { siteConfig, siteUrl } from '../../config/site.ts';
import { getCollection } from 'astro:content';

const ITEMS_PER_PAGE = 9;

const allArticles = (await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const totalPages = Math.ceil(allArticles.length / ITEMS_PER_PAGE);

const articles = allArticles.slice(0, ITEMS_PER_PAGE);

const title = `Artikel & Panduan K3LL — ${siteConfig.siteName}`;
const description = 'Kumpulan artikel, panduan, dan wawasan terbaru seputar Contractor Safety Management System (CSMS), SMK3, ISO 45001, dan perizinan korporasi di Indonesia.';
const image = siteUrl('/images/articles/articles.svg');
const seoImage = siteUrl('/images/articles/articles.svg', true);

const hasNext = totalPages > 1;
const nextUrl = hasNext ? '/articles/2/' : null;
---
<PageLayout
  title={title}
  description={description}
  image={seoImage}
  breadcrumbs={[{ label: 'Artikel', href: '/articles' }]}
>
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-16">
        <h1 class="text-3xl font-bold text-center text-gray-900 sm:text-4xl mb-4">
          Artikel & Wawasan K3LL
        </h1>
        <p class="text-center text-lg text-gray-600 max-w-2xl mx-auto">
          Informasi, panduan, dan artikel seputar standar keselamatan kerja dan perizinan bisnis untuk kontraktor profesional.
        </p>
      </header>

      <div class="articles-grid grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map(art => (
          <article class="article-card bg-gray-50 rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow flex flex-col justify-between p-6">
            <div class="article-content">
              <div class="article-meta flex items-center justify-between text-xs text-gray-500 mb-3">
                <span class="article-category bg-primary-100 text-primary-800 font-medium px-2.5 py-0.5 rounded">{art.data.category}</span>
                <span class="article-read-time">{Math.ceil(art.body.length / 1000)} menit baca</span>
              </div>
              <h2 class="article-title text-xl font-bold text-gray-900 mb-3 hover:text-primary-600 transition-colors">
                <a href={`/articles/${art.slug}`}>{art.data.title}</a>
              </h2>
              <p class="article-excerpt text-gray-600 text-sm leading-relaxed mb-6">
                {art.data.description}
              </p>
            </div>
            <div class="article-footer pt-4 border-t border-gray-200 flex items-center justify-between text-sm">
              <time class="article-date text-gray-500" datetime={art.data.pubDate}>
                {new Date(art.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <a href={`/articles/${art.slug}`} class="article-read-more text-primary-600 font-medium hover:underline">
                Baca Selengkapnya →
              </a>
            </div>
          </article>
        ))}
      </div>

      {hasNext && (
        <nav class="articles-pagination mt-12 flex items-center justify-center gap-4" aria-label="Pagination">
          <span class="pagination-info text-sm text-gray-600">
            Halaman 1 dari {totalPages}
          </span>
          <a href={nextUrl} class="pagination-link px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors font-medium">
            Selanjutnya →
          </a>
        </nav>
      )}
    </div>
  </section>
</PageLayout>