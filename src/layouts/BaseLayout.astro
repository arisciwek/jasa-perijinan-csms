---
 // Base layout for pages that do not use PageLayout
import StructuredData from '../components/StructuredData.astro';
import SEOMeta from '../components/SEOMeta.astro';
import { siteConfig, siteUrl } from '../config/site.ts';

const { title, description, image } = Astro.props;
const defaultTitle = title || siteConfig.defaultTitle;
const defaultDescription = description || siteConfig.defaultDescription;
const fullUrl = siteUrl(Astro.url.pathname, true);
---
<!DOCTYPE html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEOMeta title={defaultTitle} description={defaultDescription} image={image} url={fullUrl} />
    <StructuredData
      pageType={Astro.props.pageType || 'WebPage'}
      title={defaultTitle}
      description={defaultDescription}
      url={fullUrl}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
