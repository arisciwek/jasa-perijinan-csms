---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

const {
  title,
  description,
  image,
  pubDate,
  updatedDate,
  author = 'Tim Ahli K3LL',
  category = 'Artikel',
  tags = [],
  breadcrumbs = [],
  service = null,
  relatedArticles = [],
  headings = [],
} = Astro.props;

const fullBreadcrumbs = breadcrumbs;

const toc: TocHeading[] = headings.filter((h: TocHeading) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={title} description={description} image={image} pageType="Article">
  <div class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
    <!-- Header -->
    <Header />

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200 py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center space-x-2 text-sm text-gray-600">
          <li>
            <a href="/" class="hover:text-primary-600">Beranda</a>
          </li>
          {fullBreadcrumbs.map((crumb, index) => (
            <li class="flex items-center space-x-2">
              <span class="text-gray-400" aria-hidden="true">/</span>
              {index === fullBreadcrumbs.length - 1 ? (
                <span class="text-gray-900 font-medium truncate max-w-xs" aria-current="page">{crumb.label}</span>
              ) : (
                <a href={crumb.href} class="hover:text-primary-600">{crumb.label}</a>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <!-- Main Content Area -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-12 gap-8 min-h-[calc(100vh-200px)]">
      <!-- Sidebar (3 columns) -->
      <aside class="col-span-12 lg:col-span-3 hidden lg:block lg:sticky lg:top-24 lg:self-start space-y-6">
        <div class="max-h-[calc(100vh-260px)] overflow-y-auto space-y-6">
        <!-- Table of Contents -->
        {toc.length > 0 && (
          <nav aria-label="Daftar Isi" class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Daftar Isi</h2>
            <ul class="space-y-2 text-sm">
              {toc.map(h => (
                <li class={h.depth === 3 ? 'pl-4' : ''}>
                  <a href={`#${h.slug}`} class="hover:text-primary-600">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <!-- Related Service -->
        {service && (
          <div class="bg-primary-50 p-6 rounded-xl shadow-sm border border-primary-200">
            <h2 class="text-lg font-bold text-primary-900 mb-4">Layanan Terkait</h2>
            <div class="space-y-3">
              <h3 class="font-medium text-primary-900">
                <a href={service.href} class="hover:underline">{service.title}</a>
              </h3>
              <p class="text-sm text-primary-800">Lihat detail layanan ini untuk bantuan profesional.</p>
              <a href={service.href} class="inline-block mt-3 px-4 py-2 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors text-sm">
                Lihat Layanan →
              </a>
            </div>
          </div>
        )}

        <!-- Author Card -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
          <h2 class="text-lg font-bold text-gray-900 mb-4">Penulis</h2>
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center">
              <span class="text-primary-600 font-bold text-lg">K3</span>
            </div>
            <div>
              <p class="font-medium text-gray-900">{author}</p>
              <p class="text-sm text-gray-600">Tim Ahli K3LL</p>
            </div>
          </div>
          <p class="mt-4 text-sm text-gray-600">
            Tim ahli K3LL dengan pengalaman lebih dari 15 tahun di sektor migas, tambang, dan konstruksi.
          </p>
        </div>
      </div>
      </aside>

      <!-- Main Article Content (9 columns) -->
      <main class="col-span-12 lg:col-span-9">
        <article class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
          <header class="mb-8">
            <div class="flex items-center space-x-4 text-sm text-gray-500 mb-4">
              <span class="bg-primary-50 text-primary-700 px-3 py-1 rounded-full font-medium">{category}</span>
              {pubDate && (
                <time datetime={pubDate}>
                  {new Date(pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              )}
              <span>Oleh {author}</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight mb-4">
              {title}
            </h1>
            </header>

          <!-- Article Content -->
          <div class="prose prose-blue max-w-none text-gray-700 leading-relaxed space-y-6">
            <slot />
          </div>

          <!-- Related Articles -->
          {relatedArticles.length > 0 && (
            <div class="mt-12 pt-6 border-t border-gray-100">
              <h2 class="text-xl font-bold text-gray-900 mb-6">Artikel Terkait</h2>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {relatedArticles.map(article => (
                  <article class="bg-gray-50 p-4 rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
                    <h3 class="font-medium text-gray-900 mb-2">
                      <a href={`/articles/${article.slug}`} class="hover:text-primary-600">{article.data.title}</a>
                    </h3>
                    <p class="text-sm text-gray-600">{article.data.description}</p>
                  </article>
                ))}
              </div>
            </div>
          )}

          <!-- Tags & Share -->
          {tags.length > 0 && (
            <footer class="mt-12 pt-6 border-t border-gray-100 flex flex-wrap items-center gap-2">
              <span class="text-sm font-medium text-gray-500 mr-2">Tags:</span>
              {tags.map(tag => (
                <span class="bg-gray-100 text-gray-700 text-xs px-3 py-1 rounded-md">
                  #{tag}
                </span>
              ))}
            </footer>
          )}
        </article>
      </main>
    </div>

    <!-- Footer -->
    <Footer />
  </div>
</BaseLayout>