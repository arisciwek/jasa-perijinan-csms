---
// Base layout for all pages
import StructuredData from '../components/StructuredData.astro';
import SEOMeta from '../components/SEOMeta.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { getCollection } from 'astro:content';
import { siteConfig, siteUrl } from '../config/site.ts';
import { pickRelatedArticles } from '../utils/related.ts';

const { title, description, image, pageType = 'WebPage', breadcrumbs = [], serviceId } = Astro.props;

const relatedArticles = serviceId
  ? pickRelatedArticles(await getCollection('articles'), { serviceId, limit: 3 })
  : [];
const defaultTitle = title || siteConfig.defaultTitle;
const defaultDescription = description || siteConfig.defaultDescription;
const fullUrl = siteUrl(Astro.url.pathname);
---
<!DOCTYPE html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{defaultTitle}</title>
    <meta name="description" content={defaultDescription} />

    <!-- SEOMeta component handles Open Graph, Twitter Cards, etc -->
    <SEOMeta
      title={defaultTitle}
      description={defaultDescription}
      image={image}
      url={fullUrl}
    />

    <!-- Structured Data / Schema.org JSON-LD -->
    <StructuredData
      pageType={pageType}
      title={defaultTitle}
      description={defaultDescription}
      url={fullUrl}
    />
  </head>
  <body>
    <!-- Header -->
    <Header />

    <!-- Breadcrumb per PRD 6.3 -->
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200 py-3">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <ol class="flex items-center space-x-2 text-sm text-gray-600">
            <li>
              <a href="/" class="hover:text-primary-600">Beranda</a>
            </li>
            {breadcrumbs.map((crumb, index) => (
              <li class="flex items-center space-x-2">
                <span class="text-gray-400" aria-hidden="true">/</span>
                {index === breadcrumbs.length - 1 ? (
                  <span class="text-gray-900 font-medium" aria-current="page">{crumb.label}</span>
                ) : (
                  <a href={crumb.href} class="hover:text-primary-600">{crumb.label}</a>
                )}
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )}

    <!-- Main Content Area -->
    <main class="main-content flex-grow">
      <section class="py-16 bg-white service-detail-section">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 service-detail-container">
          <slot />
          {relatedArticles.length > 0 && (
            <RelatedArticles articles={relatedArticles} title="Artikel Terkait Layanan Ini" />
          )}
        </div>
      </section>
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>