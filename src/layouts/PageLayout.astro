---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { getCollection } from 'astro:content';

const { 
  title, 
  description, 
  image, 
  pageType = 'WebPage', 
  breadcrumbs = [],
  relatedService 
} = Astro.props;

let relatedArticles = [];
if (relatedService) {
  relatedArticles = (await getCollection('articles'))
    .filter(a => !a.data.draft && a.data.relatedService === relatedService)
    .sort((a, b) => {
      const dateA = a.data.updatedDate || a.data.pubDate;
      const dateB = b.data.updatedDate || b.data.pubDate;
      return new Date(dateB).valueOf() - new Date(dateA).valueOf();
    })
    .slice(0, 3);
}
---
<BaseLayout title={title} description={description} image={image} pageType={pageType}>
  <div class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
    <!-- Header -->
    <Header />

    <!-- Breadcrumb per PRD 6.3 -->
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200 py-3">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <ol class="flex items-center space-x-2 text-sm text-gray-600">
            <li>
              <a href="/" class="hover:text-primary-600">Beranda</a>
            </li>
            {breadcrumbs.map((crumb, index) => (
              <li class="flex items-center space-x-2">
                <span class="text-gray-400" aria-hidden="true">/</span>
                {index === breadcrumbs.length - 1 ? (
                  <span class="text-gray-900 font-medium" aria-current="page">{crumb.label}</span>
                ) : (
                  <a href={crumb.href} class="hover:text-primary-600">{crumb.label}</a>
                )}
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )}

    <!-- Main Content Area -->
    <main class="main-content flex-grow">
      <slot />
      {relatedArticles.length > 0 && (
        <RelatedArticles articles={relatedArticles} title="Artikel Terkait Layanan Ini" />
      )}
    </main>

    <!-- Footer -->
    <Footer />
  </div>
</BaseLayout>