---
// SEO Meta tags for Open Graph, Twitter Cards, and canonical URLs
import { siteConfig, siteUrl } from '../config/site.ts';

const { title, description, image, type = 'website', url } = Astro.props;

const fullUrl = url || siteUrl('', true);
const defaultImage = image
  ? (image.startsWith('http://') || image.startsWith('https://') ? image : siteUrl(image, true))
  : siteUrl(siteConfig.ogImage, true);
const siteName = siteConfig.siteName;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={fullUrl} />

<meta name="title" content={title} />

<meta property="og:type" content={type} />
<meta property="og:url" content={fullUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={defaultImage} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="article:modified_time" content={new Date().toISOString()} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={defaultImage} />
<meta name="twitter:site" content={`@${siteConfig.twitterHandle}`} />
