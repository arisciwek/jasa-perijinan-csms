---
import type { CollectionEntry } from 'astro:content';
interface Props { articles: CollectionEntry<'articles'>[]; title?: string }
const { articles, title = 'Artikel Terbaru' } = Astro.props;
---
<section class="bg-white py-12 sm:py-16" aria-labelledby="latest-articles-title"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary-700">Wawasan CSMS</p><h2 id="latest-articles-title" class="text-2xl font-bold text-gray-900 sm:text-3xl">{title}</h2></div><a href="/articles" class="shrink-0 text-sm font-semibold text-primary-700 hover:text-primary-900">Semua artikel <span aria-hidden="true">→</span></a></div>{articles.length ? <div class="grid gap-6 md:grid-cols-3">{articles.map((article) => (<article class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-md">{article.data.category && <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-primary-700">{article.data.category}</p>}<h3 class="mb-3 text-lg font-semibold leading-snug text-gray-900"><a class="hover:text-primary-700" href={`/articles/${article.slug}`}>{article.data.title}</a></h3><p class="mb-5 flex-1 text-sm leading-6 text-gray-600">{article.data.description}</p><time class="text-xs text-gray-500" datetime={article.data.pubDate}>{new Date(article.data.pubDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></article>))}</div> : <p class="text-gray-600">Belum ada artikel yang tersedia.</p>}</div></section>
