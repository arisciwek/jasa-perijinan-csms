---
import { csmsElements } from '../../config/site.ts';

interface Props {
  id: string;
  title: string;
  items: { elementId: number; description: string }[];
}

const { id, title, items } = Astro.props;
const titleId = `${id}-title`;
const cards = items.map((item) => ({
  ...item,
  element: csmsElements.find((element) => element.id === item.elementId),
})).filter((item) => item.element);
---
<section id={id} class="bg-gray-50 py-12" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id={titleId} class="text-2xl font-bold text-center text-gray-900 mb-8">
      {title}
    </h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map(({ element, description }) => element && (
        <article class="bg-white rounded-lg shadow overflow-hidden hover:shadow-lg transition-shadow duration-300">
          <div class="p-6">
            <p class="text-sm font-semibold text-primary-600 mb-2">{element.badge}</p>
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              <a href={element.href} class="hover:text-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500">
                {element.title}
              </a>
            </h3>
            <p class="text-sm text-gray-600">{description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
