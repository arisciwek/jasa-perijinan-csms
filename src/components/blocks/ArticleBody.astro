---
interface Subsection {
  title: string;
  paragraphs: string[];
}
interface Section {
  title: string;
  intro?: string;
  subsections: Subsection[];
}
interface Props {
  id: string;
  introParagraphs: string[];
  sections: Section[];
}
const { id, introParagraphs, sections } = Astro.props;
---
<article id={id} class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="prose prose-lg max-w-none prose-headings:scroll-mt-24 prose-h2:mt-12 prose-h2:border-b prose-h2:border-gray-200 prose-h2:pb-3 prose-h3:mt-8">
    {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    {sections.map((section, index) => (
      <section aria-labelledby={`${id}-section-${index + 1}`}>
        <h2 id={`${id}-section-${index + 1}`}>{section.title}</h2>
        {section.intro ? <p>{section.intro}</p> : null}
        {section.subsections.map((subsection, subIndex) => (
          <section aria-labelledby={`${id}-section-${index + 1}-subsection-${subIndex + 1}`}>
            <h3 id={`${id}-section-${index + 1}-subsection-${subIndex + 1}`}>{subsection.title}</h3>
            {subsection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
      </section>
    ))}
  </div>
</article>
