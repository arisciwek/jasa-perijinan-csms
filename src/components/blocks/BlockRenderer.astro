---
import type { ContentBlock } from '../../content/block-schema.ts';
import QuickAnswer from './QuickAnswer.astro';
import ProcessTimeline from './ProcessTimeline.astro';
import RequirementChecklist from './RequirementChecklist.astro';

interface Props {
  blocks?: ContentBlock[];
}

const { blocks = [] } = Astro.props;
---
<div class="content-blocks">
  {blocks.map((block) => {
    if (block.type === 'quick-answer') {
      return <QuickAnswer {...block.data} />;
    }

    if (block.type === 'process-timeline') {
      return <ProcessTimeline {...block.data} />;
    }

    if (block.type === 'requirement-checklist') {
      return <RequirementChecklist {...block.data} />;
    }

    return null;
  })}
</div>
