---
import type { ContentBlock } from '../../content/block-schema.ts';
import QuickAnswer from './QuickAnswer.astro';
import ProcessTimeline from './ProcessTimeline.astro';
import RequirementChecklist from './RequirementChecklist.astro';
import StatsGrid from './StatsGrid.astro';

interface Props {
  blocks?: ContentBlock[];
}

const { blocks = [] } = Astro.props;
---
{blocks.length > 0 && (
  <div class="content-blocks">
    {blocks.map((block) => {
      if (block.type === 'stats-grid') {
        return <StatsGrid id={block.id} {...block.data} />;
      }

      if (block.type === 'quick-answer') {
        return <QuickAnswer id={block.id} {...block.data} />;
      }

      if (block.type === 'process-timeline') {
        return <ProcessTimeline id={block.id} {...block.data} />;
      }

      if (block.type === 'requirement-checklist') {
        return <RequirementChecklist id={block.id} {...block.data} />;
      }

      return null;
    })}
  </div>
)}
