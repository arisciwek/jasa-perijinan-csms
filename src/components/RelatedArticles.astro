---
interface Props {
  articles: { 
    slug: string;
    data: {
      title: string;
      description: string;
      updatedDate?: string;
      pubDate: string;
    };
  }[];
  title?: string;
}
const { articles, title = 'Artikel Terkait' } = Astro.props;

const sorted = [...articles]
  .sort((a, b) => {
    const dateA = a.data.updatedDate || a.data.pubDate;
    const dateB = b.data.updatedDate || b.data.pubDate;
    return new Date(dateB).valueOf() - new Date(dateA).valueOf();
  })
  .slice(0, 3);
---
{sorted.length > 0 && (
  <section class="py-16 bg-gray-50 service-related-section rounded-xl border border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">{title}</h2>
    <div class="space-y-4">
      {sorted.map(art => (
        <article class="bg-white p-6 rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            <a href={`/articles/${art.slug}`} class="hover:text-primary-600 transition-colors">{art.data.title}</a>
          </h3>
          <p class="text-gray-600 text-sm mb-3">{art.data.description}</p>
          <a href={`/articles/${art.slug}`} class="inline-block text-primary-600 font-medium text-sm hover:underline">Baca Selengkapnya →</a>
        </article>
      ))}
    </div>
  </section>
)}